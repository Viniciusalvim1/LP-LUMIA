# Vercel Blob base URL — set after running scripts/convert-videos.sh and uploading
# Leave empty to serve videos from /public/videos/ (local dev)
NEXT_PUBLIC_BLOB_BASE_URL=

# ── Supabase: a LP usa DOIS projetos distintos ───────────────────
# Não são intercambiáveis. `posts`/`leads` não existem no CRM, e a RPC
# get_proposta_by_token não existe no projeto do blog.

# CRM — RPC get_proposta_by_token, usada por /proposta/[token]
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Blog — tabelas `posts` e `leads`
NEXT_PUBLIC_BLOG_SUPABASE_URL=
NEXT_PUBLIC_BLOG_SUPABASE_ANON_KEY=
